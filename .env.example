# ========================================================
# [필수] NVIDIA API & LLM 추론 설정 (build.nvidia.com)
# ========================================================
# build.nvidia.com 우측 상단 프로필 -> API Keys 에서 발급받은 키
NVIDIA_API_KEY=nvapi-your-key-here

# NVIDIA 통합 API 엔드포인트 (기본값)
NV_BASE_URL=https://integrate.api.nvidia.com/v1

# 메인 추론 및 Tool Calling 모델 (기본: Nemotron-3 Super)
# 사용 가능한 모델: nvidia/nemotron-3-super-120b-a12b, meta/llama-3.3-70b-instruct 등
NV_MODEL=nvidia/nemotron-3-super-120b-a12b

# ========================================================
# [선택] 안전성 검사 모델 (Content Safety Guardrail)
# ========================================================
# 입력·수집 문서 사전 안전성 검사 모델 (2026-09-28 기준 <1s 응답 확인. nemoguard-8b 는 타임아웃 발생)
NV_GUARD_MODEL=nvidia/nemotron-3.5-content-safety

# 가드 모델 오류(타임아웃 등) 시 동작 — 두 경우 모두 out/audit.jsonl 에 guard_error 로 기록
#   true  = fail-open  : 가용성 우선, 결정론적 게이트(RBAC·egress·HITL)는 항상 유지
#   false = fail-closed: 입력 거부 + 수집 문서는 unsafe 로 간주(격리 대상)
NV_GUARD_FAIL_OPEN=true

# 신뢰할 수 없는 수집 문서 격리 모드
#   dual = 정규식 인젝션 탐지 AND Content Safety unsafe → 본문 차단(보안 봉투로 대체)
#   any  = 둘 중 하나라도 탐지되면 차단
#   off  = 차단하지 않고 경고 표시만
NV_GUARD_QUARANTINE=dual

# ========================================================
# [선택] Agent 런타임 제어
# ========================================================
# 에이전트 최대 추론 루프 스텝 수 (기본: 8)
MAX_STEPS=8

# 기본 실행 권한 (analyst | viewer | admin)
AGENT_DEFAULT_ROLE=analyst

# ========================================================
# [선택] On-Prem RAG 연동 설정 (ref/on-prem-rag-service)
# ========================================================
# 로컬 개발 서버 또는 배포된 Vercel 서비스 URL
RAG_SERVICE_URL=http://localhost:3000
# RAG_SERVICE_URL=https://on-prem-rag-service.vercel.app

# ========================================================
# [선택] NVIDIA Brev GPU Cloud & OpenShell 샌드박스
# ========================================================
# brev login 후 brev ls 로 확인한 인스턴스 이름
BREV_INSTANCE_NAME=nemoclaw-gpu-instance
OPENSHELL_GATEWAY_URL=http://localhost:8080
